{
 "doc": "Кейсы автоконтролей (ТЗ, раздел 8; коды — docs/CALC_RULES.md §12). Каждый кейс = базовый кейс из tests/cases + правки. В set ключ — путь через точку (индексы списков числами), значение null означает «данных нет». expect — проблемы, которые движок обязан выдать (могут быть и другие); blocking — блокирует ли проблема попадание сотрудника в файл к начислению. statuses — ожидаемый calc_status вех и выплат.",
 "cases": [
  {"id": "A01", "title": "КУПК без текущего NPV", "base": "T02",
   "set": {"employees.0.npv_current": null},
   "expect": [{"code": "NPV_MISSING", "tab_no": "T0002", "blocking": true}]},
  {"id": "A02", "title": "КУПК без стартового NPV", "base": "T02",
   "set": {"employees.1.npv_start": null},
   "expect": [{"code": "NPV_MISSING", "tab_no": "T0003", "blocking": true}]},
  {"id": "A03", "title": "Назначение без категории", "base": "T01",
   "set": {"employees.0.category": null},
   "expect": [{"code": "ASSIGNMENT_INCOMPLETE", "tab_no": "T0001", "blocking": true}]},
  {"id": "A04", "title": "Период без % загрузки", "base": "T01",
   "set": {"employees.0.periods.0.load": null},
   "expect": [{"code": "ASSIGNMENT_INCOMPLETE", "tab_no": "T0001", "blocking": true}]},
  {"id": "A05", "title": "Дыра в периодах БГБ", "base": "T09",
   "set": {"employees.0.periods.1.from": "2026-02-01"},
   "expect": [{"code": "BGB_GAP", "tab_no": "T0014", "blocking": true}]},
  {"id": "A06", "title": "Нет плановой даты ключевой вехи", "base": "T01",
   "set": {"final.plan": null},
   "expect": [{"code": "FINAL_PLAN_MISSING", "tab_no": "T0001", "blocking": true}]},
  {"id": "A07", "title": "БС без доли перевыставления", "base": "T10b",
   "set": {"bs.share_transferred": null},
   "expect": [{"code": "BS_SHARE_MISSING", "tab_no": "T0017", "blocking": true},
              {"code": "BS_SHARE_MISSING", "tab_no": "T0018", "blocking": true}]},
  {"id": "A08", "title": "МП без KPI за квартал вехи", "base": "T11b", "set": {},
   "expect": [{"code": "KPI_MISSING", "tab_no": "T0022", "blocking": true, "milestone": "Мотивационная веха 3"}],
   "statuses": {"T0022": {"Мотивационная веха 3": "нет данных"}},
   "same_amounts_as": {"case": "T11", "milestones": ["Мотивационная веха 1", "Мотивационная веха 2", "Мотивационная веха 4", "Мотивационная веха 5", "Мотивационная веха 6"]}},
  {"id": "A09", "title": "Опережение этапа больше 100 дней", "base": "T18", "set": {},
   "expect": [{"code": "STAGE_EARLY_OVER_100", "tab_no": "T0039", "blocking": true}],
   "statuses": {"T0039": {"final": "требует решения"}}},
  {"id": "A10", "title": "Уволен в кадрах, назначение не закрыто", "base": "T01",
   "set": {"employees.0.hr_dismissal_date": "2026-01-15"},
   "expect": [{"code": "DISMISSED_ASSIGNMENT_OPEN", "tab_no": "T0001", "blocking": true}]},
  {"id": "A11", "title": "Факт есть, закрытия в 1С нет", "base": "T01",
   "set": {"milestones.2.closed_1c": null},
   "expect": [{"code": "FACT_WITHOUT_1C_CLOSE", "tab_no": null, "blocking": false, "milestone": "Мотивационная веха 3"}]},
  {"id": "A12", "title": "Загрузка изменилась больше чем на 25 п.п. за квартал", "base": "T09", "set": {},
   "expect": [{"code": "LOAD_CHANGE_25PP", "tab_no": "T0014", "blocking": false}]},
  {"id": "A13", "title": "Без проблем: базовый кейс", "base": "T01", "set": {},
   "expect": [], "expect_no_blocking": true}
 ]
}
